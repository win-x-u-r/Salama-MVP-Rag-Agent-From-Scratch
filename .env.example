OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_MODEL=openai/gpt-4o-mini

# Retrieval backend: "qdrant" (original vector-only) or "graph" (Neo4j hybrid)
RETRIEVER_BACKEND=graph

# Neo4j (Neo4j Desktop local instance defaults)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-password-here
NEO4J_DATABASE=neo4j

# ---- TTS ----
# Sentence segmentation for streamed synthesis.
#   regex  = punctuation splitter, no dependencies (default)
#   spacy  = spaCy multilingual senter; falls back to regex automatically if
#            spaCy or the model is missing, so this is safe to leave set.
# spaCy needs Python <=3.13 and:
#   pip install spacy
#   python -m spacy download xx_sent_ud_sm
TTS_SEGMENTER=regex
TTS_SPACY_MODEL=xx_sent_ud_sm
